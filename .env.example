# Copie para .env e preencha. NUNCA versione o .env.

# --- Confluent Cloud ---
ENV_NAME=pagamentos-env
CLUSTER_NAME=pagamentos-cluster
CLOUD=aws
REGION=us-east-1
POOL_NAME=pagamentos-flink

# Identidades (uma escreve, outra lê)
SA_WRITER=sa-pagamentos-writer
SA_READER=sa-pagamentos-reader

# --- Postgres (precisa ser acessível pela internet para o conector gerenciado) ---
PG_HOST=seu-host.exemplo.com
PG_PORT=5432
PG_DB=pagamentos
PG_USER=cdc_user
PG_PASSWORD=troque-me

# --- CDC ---
TOPIC_PREFIX=pgpag
SLOT_NAME=pgpag_slot
PUBLICATION_NAME=pgpag_pub

# --- Schema Registry (preenchidos após o setup) ---
SR_URL=https://psrc-xxxxx.region.provider.confluent.cloud
SR_API_KEY=
SR_API_SECRET=
